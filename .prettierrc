{
  "useTabs": true,
  "singleQuote": false,
  "semi": false,
  "trailingComma": "none",
  "printWidth": 80,
  "htmlWhitespaceSensitivity": "ignore",
  "plugins": ["prettier-plugin-svelte"],
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    }
  ]
}
