{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "declaration": true,
    "jsx": "react",
    "jsxFactory": "kiru.createElement",
    "jsxFragmentFactory": "kiru.Fragment"
  },
  "include": ["src"]
}
